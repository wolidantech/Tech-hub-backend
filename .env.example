# =================================================================
# WOLI DAN TECH HUB — Secure AI Gateway
# Copy this file to ".env" for local development, or set the same
# keys in Railway → your service → Variables.
#
# NEVER commit real values. The service role key and the LLM API key
# are SECRETS: server side only, never sent to the browser.
# =================================================================

# ---- LLM provider (pick ONE provider) ----
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Required for AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key

# Required for AI_PROVIDER=anthropic  (e.g. AI_MODEL=claude-3-5-haiku-latest)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Required for AI_PROVIDER=gemini     (e.g. AI_MODEL=gemini-1.5-flash)
GEMINI_API_KEY=your-gemini-key

# Optional: OpenAI-compatible base URL (proxies / self-hosted gateways)
AI_BASE_URL=

# Generation tuning. AI_TIMEOUT_MS must stay below 30000 — the frontend
# aborts the DanTECH chat request at 30 seconds.
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=2

# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://your-project-ref.supabase.co
# SECRET — bypasses RLS for trusted server-side reads. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- CORS: comma-separated list of allowed frontend origins ----
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ---- Server ----
# Railway injects PORT automatically — do not set it on Railway.
PORT=5000
NODE_ENV=production

# ---- Rate limits (per authenticated user, per window) ----
CHAT_RATE_LIMIT=30
GENERATE_RATE_LIMIT=10
RATE_WINDOW_MS=60000

# ---- Input + retrieval limits ----
MAX_MESSAGE_CHARS=4000
MAX_HISTORY=12
RAG_MAX_DOCS=6
RAG_MAX_CHARS_PER_DOC=2000

# =================================================================
# Legacy LMS backend only — needed solely for `npm run start:lms`,
# which is NOT the deployed service. See README section 9.
# =================================================================
# SUPABASE_ANON_KEY=your-anon-key
# FRONTEND_URL=http://localhost:5173
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# ADMIN_EMAIL=wolidantech@gmail.com
# ADMIN_INITIAL_PASSWORD=
