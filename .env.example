# =================================================================
# WOLI DAN TECH HUB - Backend environment configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file and NEVER expose the service
# role key to the browser/frontend.
# =================================================================

# ---- Supabase project (Project Settings -> API) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# SECRET - server side only. Required for admin operations,
# storage uploads, signed URLs and database triggers bypass.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma separated list of allowed frontend origins for CORS
# (include your Arena preview host when developing)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ---- PostgreSQL connection string (Project Settings -> Database)
# Used ONLY by scripts/migrate.js to run supabase/migrations/*.sql
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# ---- Initial administrator bootstrap (scripts/create-admin.js) ----
ADMIN_EMAIL=wolidantech@gmail.com
# Set the initial admin password here (server-side secret) or pass
# it interactively when running: npm run create:admin
ADMIN_INITIAL_PASSWORD=

# Set to "true" to skip e-mail confirmation for self-serve signup
# (keep false in production unless you have SMTP configured)
AUTO_CONFIRM_EMAIL=false

# Upload limits
MAX_RECEIPT_SIZE_MB=5
MAX_RESOURCE_SIZE_MB=20
