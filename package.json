{
  "name": "woli-dan-tech-hub-backend",
  "version": "1.0.0",
  "description": "Production backend for WOLI DAN TECH HUB online learning platform (Supabase + PostgreSQL + Express)",
  "main": "src/server.js",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "create:admin": "node scripts/create-admin.js",
    "storage:setup": "node scripts/setup-storage.js",
    "check": "node scripts/check.js",
    "check:env": "node scripts/check-env.js",
    "test": "npm run check && npm run test:db",
    "test:db": "node scripts/test-db.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.15.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@embedded-postgres/linux-x64": "18.4.0-beta.17",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.13.0",
    "pgsql-parser": "^14.0.0"
  }
}
