{
  "name": "woli-dan-tech-hub-backend",
  "version": "1.0.0",
  "description": "Secure AI gateway + LMS backend for WOLI DAN TECH HUB (Supabase + PostgreSQL + Express)",
  "main": "src/gateway/server.js",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/gateway/server.js",
    "dev": "node --watch src/gateway/server.js",
    "start:lms": "node src/server.js",
    "dev:lms": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "create:admin": "node scripts/create-admin.js",
    "storage:setup": "node scripts/setup-storage.js",
    "check": "node scripts/check.js",
    "check:catalog": "node scripts/check-catalog.js",
    "check:classroom": "node scripts/check-classroom.js",
    "validate:sql": "node scripts/validate-sql.mjs",
    "test": "npm run check && npm run test:gateway && npm run test:payments && npm run test:ai-content && npm run test:cv && npm run test:mobile",
    "test:gateway": "node scripts/test-gateway.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "test:ai-content": "node scripts/test-ai-content.mjs",
    "test:cv": "node scripts/test-cv.mjs",
    "test:mobile": "node scripts/test-mobile.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:seed": "node scripts/test-seed.mjs",
    "test:db:all": "npm run test:db && npm run test:seed",
    "seed": "node scripts/seed.mjs",
    "seed:export": "node scripts/seed.mjs --export-sql=supabase/seed/science_courses.sql",
    "study-guides": "node scripts/generate-study-guides.mjs",
    "populate:ai": "node scripts/populate-ai-content.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.15.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@embedded-postgres/linux-x64": "18.4.0-beta.17",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.13.0",
    "pgsql-parser": "^14.0.0"
  }
}
